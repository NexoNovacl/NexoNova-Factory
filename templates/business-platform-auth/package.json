{
  "name": "business-platform-auth-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "next build",
    "generate": "prisma generate",
    "migrate": "node scripts/migrate-check.mjs",
    "compile:checks": "tsc -p tsconfig.checks.json",
    "bootstrap-admin": "node build-checks/scripts/bootstrap-admin.js",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@prisma/client": "7.5.0",
    "@prisma/adapter-pg": "7.5.0",
    "pg": "8.16.3",
    "better-auth": "1.7.5"
  },
  "devDependencies": {
    "prisma": "7.5.0",
    "typescript": "5.9.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.11.11"
  }
}
