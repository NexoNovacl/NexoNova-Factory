{
  "additionalProperties": false,
  "properties": {
    "auth": {
      "enum": [
        {
          "bootstrap": "offline-only",
          "defaultPassword": "forbidden",
          "emailProvider": false,
          "enforcement": "NOT_IMPLEMENTED",
          "logout": "revoke",
          "method": "email-password",
          "mfa": false,
          "oauth": false,
          "provider": "better-auth",
          "publicSignup": "closed",
          "recoveryEmail": false,
          "rememberMe": false,
          "sessionMaxSeconds": 28800
        }
      ]
    },
    "capability": {
      "enum": [
        "business-platform"
      ],
      "type": "string"
    },
    "coreVersion": {
      "enum": [
        "0.1.0"
      ],
      "type": "string"
    },
    "format": {
      "enum": [
        "nexonova.business-platform.v0.1.0"
      ],
      "type": "string"
    },
    "modules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "[a-z0-9][a-z0-9-]{0,62}",
            "type": "string"
          },
          "version": {
            "enum": [
              "0.1.0"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "persistence": {
      "enum": [
        {
          "credentials": "runtime-migrator-separated",
          "engine": "postgresql",
          "implementation": "NOT_IMPLEMENTED",
          "isolation": "database-network-volume-secret-session-per-product",
          "major": 16,
          "migrationTool": "prisma-migrate",
          "orm": "prisma",
          "ormMajor": 7,
          "runtimeDDL": "forbidden"
        }
      ]
    },
    "policy": {
      "enum": [
        {
          "admin": "all-in-product",
          "archive": "archivedAt",
          "clientOwnerId": "forbidden",
          "concurrency": "expected-version-or-409",
          "enforcement": "NOT_IMPLEMENTED",
          "foreignResource": "uniform-404",
          "member": "own-only",
          "owner": "session-derived",
          "physicalDelete": "forbidden",
          "reassignment": "forbidden",
          "roleEditing": "forbidden",
          "roles": [
            "admin",
            "member"
          ],
          "states": [
            "open",
            "closed"
          ]
        }
      ]
    },
    "productId": {
      "pattern": "[a-z0-9][a-z0-9-]{0,62}",
      "type": "string"
    },
    "public": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "[A-Za-z\u00c0-\u00ff0-9 .-]+",
          "type": "string"
        },
        "primaryColor": {
          "pattern": "#[a-fA-F0-9]{6}",
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "[A-Za-z\u00c0-\u00ff0-9 .-]+",
          "type": "string"
        }
      },
      "required": [
        "name",
        "title",
        "primaryColor"
      ],
      "type": "object"
    },
    "restrictions": {
      "enum": [
        {
          "bootstrap": "forbidden",
          "data": "synthetic-only",
          "deployment": "forbidden",
          "externalProviders": "forbidden",
          "generation": "forbidden",
          "infrastructure": "forbidden",
          "migrations": "forbidden",
          "organization": "one-per-product"
        }
      ]
    },
    "targets": {
      "enum": [
        {
          "api": "route-handlers-domain-services",
          "auth": "better-auth",
          "database": "postgresql-16",
          "exactCompatibility": "PENDING_P4.3",
          "language": "typescript",
          "next": "app-router",
          "orm": "prisma-7",
          "ui": "react-css-modules"
        }
      ]
    }
  },
  "required": [
    "format",
    "productId",
    "capability",
    "coreVersion",
    "modules",
    "public",
    "auth",
    "policy",
    "persistence",
    "targets",
    "restrictions"
  ],
  "type": "object"
}
