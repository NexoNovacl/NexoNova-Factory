{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "productId",
    "profile",
    "planHash",
    "specHash",
    "inventoryHash",
    "adaptationHash",
    "generatorHash",
    "files",
    "launcher",
    "migrations",
    "transforms",
    "limitations",
    "excludes"
  ],
  "properties": {
    "format": {
      "const": "nexonova.business-generation-manifest.v1"
    },
    "productId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "profile": {
      "const": "business-auth-internal-requests-0.1.0-d02"
    },
    "planHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "specHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "inventoryHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "adaptationHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generatorHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "owner",
          "provenance"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "owner": {
            "enum": [
              "auth-core",
              "internal-requests",
              "composition"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "transform"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "transform": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "launcher": {
      "const": [
        "node",
        "scripts/start-requests.mjs"
      ]
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "transforms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "excludes": {
      "const": [
        "factory-generation/manifest.json",
        "factory-generation/metadata.json"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
