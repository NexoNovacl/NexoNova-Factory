{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "workOrderHash",
    "generationManifestHash",
    "adaptationHash",
    "runId",
    "productId",
    "actions",
    "humanApprovalRef",
    "expiresAt",
    "revoked",
    "executionAuthority"
  ],
  "properties": {
    "format": {
      "const": "nexonova.business-execution-authorization.v1"
    },
    "workOrderHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generationManifestHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "adaptationHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "productId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "actions": {
      "type": "array",
      "items": {
        "enum": [
          "stage",
          "promote",
          "install",
          "build",
          "docker",
          "migrate",
          "bootstrap-fixtures",
          "http-browser",
          "fault-injection",
          "cleanup"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "humanApprovalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "revoked": {
      "const": false
    },
    "executionAuthority": {
      "const": "external-operator-context-only"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
