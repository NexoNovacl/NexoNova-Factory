{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "productId",
    "public",
    "profile",
    "modules",
    "executionAuthority"
  ],
  "properties": {
    "format": {
      "const": "nexonova.public-business-generation.v1"
    },
    "productId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "public": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "primaryColor"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "primaryColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "profile": {
      "const": "business-auth-internal-requests-0.1.0-d02"
    },
    "modules": {
      "const": [
        {
          "id": "internal-requests",
          "version": "0.1.0"
        }
      ]
    },
    "executionAuthority": {
      "const": "none"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
